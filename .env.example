# Set a random device token before enabling Wi-Fi / external USB ingestion.
AGROEDGE_DEVICE_TOKEN=
# Coordinates: municipal reference point in Toca, Boyacá.
AGROEDGE_LAT=5.56112
AGROEDGE_LON=-73.18294
AGROEDGE_STALE_SECONDS=30
# AGROEDGE_PYTHON=C:/path/to/python.exe
# AGROEDGE_DB=data/agroedge.sqlite
# Carpeta opcional de agroclima.sqlite. El CLI Python también admite --dir.
# AGROEDGE_R5_DIR=C:/AgroEdge/boletines
# Set to 1 only for isolated fixture testing.
AGROEDGE_ALLOW_TESTS=0

